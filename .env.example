PORT=5000
HOST=0.0.0.0
NODE_ENV=development
BACKEND_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=localhost

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# App database
DATABASE_URL=postgresql://user:password@localhost:5432/abio

# Separate DB for tests (vitest swaps this into DATABASE_URL). Never point at prod/dev data.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/abio_test

REDIS_URL=redis://127.0.0.1:6379
LOG_LEVEL=info

EMAIL_FROM_NAME=Abio
EMAIL_FROM=noreply@example.com

# smtp (local default) | brevo (Railway / production HTTPS API)
EMAIL_PROVIDER=smtp

# Required when EMAIL_PROVIDER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Required when EMAIL_PROVIDER=brevo (Brevo → SMTP & API → API keys)
BREVO_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_PROJECT_ID=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

TOTP_SECRET=change-me-to-a-long-random-hex-string

# Optional — first admin account (npm run db:seed). Top role name is "admin" (not super_admin).
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Abio Admin
