{
  "name": "abio.site",
  "version": "0.0.1",
  "description": "Abio.site backend",
  "author": "Ridwan Adeyemo",
  "repository": "rhedwan/abio.site",
  "license": "MIT",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts | pino-pretty",
    "build": "tsup",
    "start": "node dist/index.js",
    "clean": "rimraf dist coverage",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy",
    "worker:email": "tsx src/queues/email.worker.ts | pino-pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@otplib/plugin-base32-scure": "^13.4.0",
    "@otplib/plugin-crypto-node": "^13.4.0",
    "@otplib/totp": "^13.4.0",
    "@otplib/uri": "^13.4.0",
    "@prisma/client": "^6.17.1",
    "@types/moment": "^2.11.29",
    "@types/supertest": "^7.2.1",
    "apple-signin-auth": "^2.0.0",
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.7",
    "envalid": "^8.0.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "form-data": "^4.0.4",
    "google-auth-library": "^10.3.0",
    "helmet": "^8.0.0",
    "html-to-text": "^9.0.5",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.12.11",
    "moment": "^2.30.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nanoid": "^5.1.6",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.9",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pug": "^3.0.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "stripe": "^18.5.0",
    "supertest": "^7.2.2",
    "swagger-ui-express": "5.0.1",
    "uuid": "^14.0.1",
    "validator": "^13.15.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/html-to-text": "^9.0.4",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pug": "^2.0.10",
    "@types/qrcode": "^1.5.6",
    "@types/sharp": "^0.31.1",
    "@types/swagger-ui-express": "4.1.8",
    "@types/validator": "^13.12.2",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.17.1",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.8"
  },
  "tsup": {
    "entry": [
      "src",
      "!src/**/__tests__/**",
      "!src/**/*.test.*"
    ],
    "splitting": false,
    "sourcemap": true,
    "clean": true
  }
}
