generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  standard
  custom
}

enum OrderStatus {
  processing
  ready
  shipped
  received
  cancelled
}

enum PaymentStatus {
  pending
  success
  failed
  reversed
}

enum PaymentProvider {
  bach
  paystack
  opay
}

enum AdminInviteRole {
  moderator
}

model Waitlist {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  name      String   @default("Anonymous")

  @@map("waitlists")
}

model User {
  id                       String              @id @default(uuid())
  email                    String              @unique
  active                   Boolean             @default(true)
  password                 String
  passwordChangedAt        DateTime?           @db.Timestamptz(6)
  passwordResetToken       String?
  passwordResetExpires     DateTime?           @db.Timestamptz(6)
  createdAt                DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime            @updatedAt @db.Timestamptz(6)
  isEmailVerified          Boolean             @default(false)
  emailVerificationExpires DateTime?           @db.Timestamptz(6)
  emailVerificationToken   String?
  name                     String
  profile                  Profile?
  isOnboardingCompleted    Boolean             @default(false)
  displayPreferences       DisplayPreference[]
  googleId                 String?
  totp_secret              String?

  roles                    UserRole[]
  refreshTokens            RefreshToken[]
  verificationBadges       VerificationBadge[] @relation("BadgeOwner")
  badgesAssigned           VerificationBadge[] @relation("BadgeAssignedBy")
  badgesRevoked            VerificationBadge[] @relation("BadgeRevokedBy")
  astoreOrders             AStoreOrder[]
  payments                 Payment[]
  adminInvitesSent         AdminInvite[]       @relation("AdminInvitesSent")
  adminInviteAccepted      AdminInvite[]       @relation("AdminInviteAccepted")
  adminAuditLogs           AdminAuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Profile {
  id        String             @id @default(uuid())
  userId    String             @unique
  createdAt DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @db.Timestamptz(6)
  avatarUrl String?
  bio       String?
  // displayName String?
  goals     String[]           @default([])
  isPublic  Boolean            @default(true)
  location  String?
  username  String?            @unique
  links     Link[]
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  display   DisplayPreference?

  @@map("profiles")
}

model Link {
  id           String   @id @default(uuid())
  profileId    String
  title        String
  url          String
  platform     String?
  displayOrder Int      @default(0)
  isVisible    Boolean  @default(true)
  clickCount   Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  icon_link    String?
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([displayOrder])
  @@map("links")
}

model DisplayPreference {
  id               String        @id @default(uuid())
  userId           String
  profileId        String        @unique
  selected_theme   String?
  font_config      Json?         @default("{}")
  corner_config    Json?         @default("{}")
  wallpaper_config Json?         @default("{}")
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)
  profile          Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme            DisplayTheme? @relation(fields: [selected_theme], references: [id])

  @@map("display_preferences")
}

model DisplayTheme {
  id                 String              @id @default(uuid())
  name               String              @unique
  active             Boolean             @default(true)
  font_config        Json?               @default("{}")
  corner_config      Json?               @default("{}")
  wallpaper_config   Json?               @default("{}")
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)
  displayPreferences DisplayPreference[]

  @@map("theme_configurations")
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@map("role_permissions")
}

model UserRole {
  id     Int    @id @default(autoincrement())
  userId String
  roleId Int
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model VerificationBadge {
  id           String    @id @default(uuid())
  userId       String
  assignedById String
  assignedAt   DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt    DateTime? @db.Timestamptz(6)
  revokedById  String?
  revokeReason String?
  /** e.g. "verified" — one row per (user, type); re-assign clears revokedAt on same row */
  badgeType    String    @default("verified")

  user       User  @relation("BadgeOwner", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User  @relation("BadgeAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  revokedBy  User? @relation("BadgeRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@unique([userId, badgeType])
  @@index([userId])
  @@map("verification_badges")
}

model AStoreProduct {
  id            String                 @id @default(uuid())
  name          String
  slug          String                 @unique
  description   String?
  active        Boolean                @default(true)
  type          ProductType
  currency      String                 @default("NGN")
  basePriceKobo Int
  createdAt     DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @db.Timestamptz(6)
  variants      AStoreProductVariant[]
  orderItems    AStoreOrderItem[]

  @@map("astore_products")
}

model AStoreProductVariant {
  id        String   @id @default(uuid())
  productId String
  colorName String
  colorHex  String?
  imageUrls String[]
  stockQty  Int      @default(0)
  priceKobo Int?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  product    AStoreProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems AStoreOrderItem[]

  @@unique([productId, colorName])
  @@index([productId])
  @@map("astore_product_variants")
}

model AStoreOrder {
  id              String      @id @default(uuid())
  userId          String
  status          OrderStatus @default(processing)
  totalAmountKobo Int
  currency        String      @default("NGN")
  trackingNumber  String?
  shippingAddress String?
  createdAt       DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(6)

  items   AStoreOrderItem[]
  payment Payment?
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("astore_orders")
}

model AStoreOrderItem {
  id             String         @id @default(uuid())
  orderId        String
  productId      String
  variantId      String?
  quantity       Int
  unitPriceKobo  Int
  customUsername String?
  preferredColor String?
  instructions   String?
  artworkUrl     String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)

  // Order history should survive catalog edits:
  // - deleting a color → clear variantId (SetNull)
  // - deleting a product still sold in past orders → blocked (Restrict)
  variant AStoreProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  product AStoreProduct         @relation(fields: [productId], references: [id], onDelete: Restrict)
  order   AStoreOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("astore_order_items")
}

model Payment {
  id          String          @id @default(uuid())
  orderId     String          @unique
  userId      String
  provider    PaymentProvider @default(bach)
  providerRef String?         @unique
  amountKobo  Int
  currency    String          @default("NGN")
  status      PaymentStatus   @default(pending)
  rawWebhook  Json?
  paidAt      DateTime?       @db.Timestamptz(6)
  failedAt    DateTime?       @db.Timestamptz(6)
  reversedAt  DateTime?       @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(6)

  order       AStoreOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
  @@map("payments")
}

model AdminInvite {
  id              String          @id @default(uuid())
  email           String
  role            AdminInviteRole
  tokenHash       String          @unique
  invitedById     String          
  expiresAt       DateTime        @db.Timestamptz(6)
  acceptedAt      DateTime?       @db.Timestamptz(6)
  acceptedUserId  String?         
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)

  invitedBy       User            @relation("AdminInvitesSent", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedUser    User?           @relation("AdminInviteAccepted", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  @@map("admin_invites")
  @@index([email])
}

model AdminAuditLog {
  id              String          @id @default(uuid())
  adminId         String
  action          String
  resourceType    String
  resourceId      String
  oldValue        Json?
  newValue        Json?
  metadata        Json?
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  admin           User            @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([resourceType, resourceId])
  @@index([createdAt])

  @@map("admin_audit_logs")
}